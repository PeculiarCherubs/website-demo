{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peculiar-cherubs-admin",
  "main": "admin-worker/src/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "admin.peculiarcherubs.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peculiar-cherubs-production",
      "database_id": "45c6f7a8-3334-40a1-ada6-c030ee00ebec",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CMS_PROVIDER": "cloudflare-d1",
    "TEAM_DOMAIN": "https://peculiarcherubs.cloudflareaccess.com",
    "POLICY_AUD": "65cb095d358324b5a7e745c8b7652048ff6471099d3781bb586ef05bf89cc1af",
    "PUBLIC_SNAPSHOT_PREFIX": "public"
  },
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_SNAPSHOTS",
      "bucket_name": "peculiar-cherubs-public-production"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "peculiar-cherubs-media-production"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}