{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peculiar-cherubs-admin-staging",
  "main": "admin-worker/src/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peculiar-cherubs-staging",
      "database_id": "8b8d96eb-3c83-4be6-ab43-59de3fbef33a",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "CMS_PROVIDER": "cloudflare-d1",
    "TEAM_DOMAIN": "https://peculiarcherubs.cloudflareaccess.com",
    "POLICY_AUD": "082349719b39eea70a356cd643550ab89acf448ba627548b0c984442e01c5af8"
  },
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
